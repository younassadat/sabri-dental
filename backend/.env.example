# Supabase project settings -> API Keys
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "Secret key" (starts with sb_secret_...) under Settings -> API Keys -> Secret keys.
# Click the eye icon to reveal it, then copy. Never put this in the frontend.
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated list of allowed origins for the desktop app.
# Leave as * while developing; tighten later if you ever add a web version.
ALLOWED_ORIGINS=*
